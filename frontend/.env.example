# HSD Platform Frontend - Environment Variables Template
# Copy this file to '.env' for local development or set these variables in Vercel/Railway.

# The base URL of your Django backend API server
VITE_API_URL=http://localhost:8000

# The WebSocket URL of your Django backend ASGI server
# (If omitted, it will automatically default to ws/wss derived from VITE_API_URL)
# VITE_WS_URL=ws://localhost:8000
